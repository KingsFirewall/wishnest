# Copy to .env.local for local development, and add the same names in
# Vercel → Settings → Environment Variables (Production and Preview).

# Supabase → Project Settings → Data API. Public (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key. Public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Supabase → Project Settings → API Keys → Secret key. SERVER ONLY.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Supabase → Connect → Transaction pooler (port 6543). SERVER ONLY.
# Replace your-database-password; copy the exact host from the Connect panel.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
